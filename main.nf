    export TOOL_DIR="\$PWD/tooldir" STEP='abricate_cdip'
    mkdir -p out tooldir
    export S_db='${params.settings.abricate_cdip.db}'
    export S_minid='${params.settings.abricate_cdip.minid}'
    export S_mincov='${params.settings.abricate_cdip.mincov}'
    export S_noheader='${params.settings.abricate_cdip.noheader}'
    export IN_contigs='${in_contigs}'

    cp -L "\$IN_contigs" "\$SAMPLE.fasta"
    args=()
    [ "\$S_noheader" = true ] && args+=(--noheader)
    abricate --threads "\$CPUS" --db "\$S_db" --minid "\$S_minid" --mincov "\$S_mincov" "\${args[@]}" \\
        "\$SAMPLE.fasta" > "out/\$SAMPLE.abricate.tsv"

    printf '%s: %s\\n' 'abricate' "\$( (abricate --version 2>&1 | sed 's/^abricate //') 2>&1 | head -1 )" >> versions.yml
    printf '%s: %s\\n' 'abricate_db_dates' "\$( (abricate --list 2>/dev/null | awk 'NR>1{printf "%s%s=%s", s, \$1, \$4; s=", "} END{print ""}') 2>&1 | head -1 )" >> versions.yml
    echo 'container.STEP_abricate_cdip: quay.io/biocontainers/abricate:1.4.0--h05cac1d_0' >> versions.yml
    [ -f .ntg_notes ] && sed 's/^/note.abricate_cdip./' .ntg_notes >> versions.yml || true
    """
}
