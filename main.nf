// Contamination and completeness screen: CheckM 1.2.3
process STEP_checkm {
    tag 'checkm'
    container 'quay.io/biocontainers/checkm-genome:1.2.3--pyhdfd78af_1'
    cpus 8
    memory '15 GB'
    publishDir path: { "${params.outdir}/combined/checkm" }, mode: 'copy', saveAs: { fn -> fn.startsWith('out/') ? fn.substring(4) : null }

    input:
    path(in_contigs, stageAs: 'in_contigs/*')
    path(db_checkm_data)

    output:
    path('out/checkm_results.tsv'), emit: results
    path('versions.yml'), emit: versions

    script:
    def meta = [id: 'all']
    """
    export SAMPLE='${meta.id}' CPUS=${task.cpus} MEM_GB=${task.memory.toGiga()}
    export TOOL_DIR="\$PWD/tooldir" STEP='checkm'
    mkdir -p out tooldir
    export S_tree='${params.settings.checkm.tree}'
    export S_unique='${params.settings.checkm.unique}'
    export S_multi='${params.settings.checkm.multi}'
    mkdir -p in_contigs; export IN_contigs_DIR="\$PWD/in_contigs"
    export DB_checkm_data="\$(readlink -f '${db_checkm_data}')"

    mkdir -p bins
    for f in "\$IN_contigs_DIR"/*; do
        n=\$(basename "\$f"); n=\${n%.contigs.fa}
        cp -L "\$f" "bins/\$n.fasta"
    done
    ram_gb=\$(awk '/MemTotal/{print int(\$2/1048576)}' /proc/meminfo)
    tree="\$S_tree"
    if [ "\$tree" = auto ]; then
        if [ "\$ram_gb" -ge 40 ]; then tree=full; else tree=reduced; fi
        echo "tree: \$tree (auto; computer has \$ram_gb GB RAM, full tree needs ~40 GB)" >> .ntg_notes
    else
        echo "tree: \$tree (set by user)" >> .ntg_notes
    fi
    args=()
    [ "\$tree" = reduced ] && args+=(--reduced_tree)
    export CHECKM_DATA_PATH="\$DB_checkm_data"
    checkm lineage_wf -t "\$CPUS" --pplacer_threads 1 -x fasta \\
        -u "\$S_unique" -m "\$S_multi" "\${args[@]}" \\
        --tab_table -f out/checkm_results.tsv bins checkm_out

    printf '%s: %s\\n' 'checkm' "\$( (checkm 2>&1 | grep -o 'CheckM v[0-9.]*' | sed 's/CheckM v//') 2>&1 | head -1 )" >> versions.yml
    echo 'container.STEP_checkm: quay.io/biocontainers/checkm-genome:1.2.3--pyhdfd78af_1' >> versions.yml
    [ -f .ntg_notes ] && sed 's/^/note.checkm./' .ntg_notes >> versions.yml || true
    """
}
// Assembly assessment: QUAST 5.3.0
process STEP_quast {
    tag 'quast'
    container 'quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2'
    cpus 4
    memory '4 GB'
    publishDir path: { "${params.outdir}/combined/quast" }, mode: 'copy', saveAs: { fn -> fn.startsWith('out/') ? fn.substring(4) : null }

    input:
    path(in_contigs, stageAs: 'in_contigs/*')

    output:
    path('out/report.tsv'), emit: report
    path('out/transposed_report.tsv'), emit: transposed
    path('out/report.html'), emit: html
    path('versions.yml'), emit: versions

    script:
    def meta = [id: 'all']
    """
    export SAMPLE='${meta.id}' CPUS=${task.cpus} MEM_GB=${task.memory.toGiga()}
    export TOOL_DIR="\$PWD/tooldir" STEP='quast'
    mkdir -p out tooldir
    export S_min_contig='${params.settings.quast.min_contig}'
    export S_contig_thresholds='${params.settings.quast.contig_thresholds}'
    mkdir -p in_contigs; export IN_contigs_DIR="\$PWD/in_contigs"

    files=(); labels=()
    for f in "\$IN_contigs_DIR"/*; do
        n=\$(basename "\$f"); n=\${n%.contigs.fa}
        files+=("\$f"); labels+=("\$n")
    done
    quast.py -o quast_out --threads "\$CPUS" \\
        --min-contig "\$S_min_contig" \\
        --contig-thresholds "\$S_contig_thresholds" \\
        -l "\$(IFS=,; echo "\${labels[*]}")" \\
        "\${files[@]}"
    cp quast_out/report.tsv quast_out/transposed_report.tsv quast_out/report.html out/

    printf '%s: %s\\n' 'quast' "\$( (quast.py --version 2>&1 | grep -o 'QUAST v[0-9.]*' | sed 's/QUAST v//') 2>&1 | head -1 )" >> versions.yml
    echo 'container.STEP_quast: quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2' >> versions.yml
    [ -f .ntg_notes ] && sed 's/^/note.quast./' .ntg_notes >> versions.yml || true
    """
}
// AMR (abriTAMR): abriTAMR 1.3.0
process STEP_abritamr {
    tag { "${meta.id}" }
    container 'quay.io/biocontainers/abritamr:1.3.0--pyh5707d69_0'
    cpus 4
    memory '4 GB'
    publishDir path: { "${params.outdir}/samples/${meta.id}/abritamr" }, mode: 'copy', saveAs: { fn -> fn.startsWith('out/') ? fn.substring(4) : null }

    input:
    tuple val(meta), path(in_contigs)

    output:
    tuple val(meta), path("out/${meta.id}.abritamr.summary_matches.txt"), emit: matches
    tuple val(meta), path("out/${meta.id}.abritamr.summary_partials.txt"), emit: partials
    tuple val(meta), path("out/${meta.id}.abritamr.summary_virulence.txt"), emit: virulence
    tuple val(meta), path("out/${meta.id}.amrfinder.out"), emit: amrfinder
    path('versions.yml'), emit: versions

    script:
    """
    export SAMPLE='${meta.id}' CPUS=${task.cpus} MEM_GB=${task.memory.toGiga()}
    export TOOL_DIR="\$PWD/tooldir" STEP='abritamr'
    mkdir -p out tooldir
    export S_species='${params.settings.abritamr.species}'
    export S_identity='${params.settings.abritamr.identity}'
    export IN_contigs='${in_contigs}'

    args=()
