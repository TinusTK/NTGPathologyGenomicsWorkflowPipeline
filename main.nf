workflow {
    main:
    // The UI pairs the reads and passes them as samples.csv (sample,r1,r2);
    // without one, pair the files in --input with reads_pattern.
    def ch_input = params.samplesheet
        ? channel.fromPath(params.samplesheet, checkIfExists: true).splitCsv(header: true)
            .map { row -> tuple([id: row.sample], [file(row.r1, checkIfExists: true), file(row.r2, checkIfExists: true)]) }
        : channel.fromFilePairs("${params.input}/${params.reads_pattern}", checkIfExists: true)
            .map { id, files -> tuple([id: id], files) }
    def versions = channel.empty()

    // ---- fastp
    def ch_fastp_reads = channel.empty()
    def ch_fastp_html = channel.empty()
    def ch_fastp_json = channel.empty()
    def run_fastp = params.steps.fastp.toString() == 'true' && (true)
    if (run_fastp) {
        STEP_fastp(ch_input)
        ch_fastp_reads = STEP_fastp.out.reads
        ch_fastp_html = STEP_fastp.out.html
        ch_fastp_json = STEP_fastp.out.json
        versions = versions.mix(STEP_fastp.out.versions)
    }

    // ---- shovill
    def ch_shovill_contigs = channel.empty()
    def ch_shovill_log = channel.empty()
    def run_shovill = params.steps.shovill.toString() == 'true' && (run_fastp || true)
    if (run_shovill) {
        STEP_shovill((run_fastp ? ch_fastp_reads : ch_input))
        ch_shovill_contigs = STEP_shovill.out.contigs
        ch_shovill_log = STEP_shovill.out.log
        versions = versions.mix(STEP_shovill.out.versions)
    }

    // ---- kraken2
    def ch_kraken2_report = channel.empty()
    def run_kraken2 = params.steps.kraken2.toString() == 'true' && (run_fastp || true)
    if (run_kraken2) {
        STEP_kraken2((run_fastp ? ch_fastp_reads : ch_input), file(params.databases.kraken2_standard_8, checkIfExists: true))
        ch_kraken2_report = STEP_kraken2.out.report
        versions = versions.mix(STEP_kraken2.out.versions)
    }

    // ---- bracken
    def ch_bracken_abundance = channel.empty()
    def ch_bracken_report = channel.empty()
    def run_bracken = params.steps.bracken.toString() == 'true' && (run_kraken2)
    if (run_bracken) {
        STEP_bracken(ch_kraken2_report, file(params.databases.kraken2_standard_8, checkIfExists: true))
        ch_bracken_abundance = STEP_bracken.out.abundance
        ch_bracken_report = STEP_bracken.out.report
        versions = versions.mix(STEP_bracken.out.versions)
    }

    // ---- sistr
    def ch_sistr_prediction = channel.empty()
    def run_sistr = params.steps.sistr.toString() == 'true' && (run_shovill)
    if (run_sistr) {
        STEP_sistr(ch_shovill_contigs)
        ch_sistr_prediction = STEP_sistr.out.prediction
        versions = versions.mix(STEP_sistr.out.versions)
    }

    // ---- mlst
    def ch_mlst_report = channel.empty()
    def run_mlst = params.steps.mlst.toString() == 'true' && (run_shovill)
    if (run_mlst) {
        STEP_mlst(ch_shovill_contigs)
        ch_mlst_report = STEP_mlst.out.report
        versions = versions.mix(STEP_mlst.out.versions)
    }

    // ---- staramr
    def ch_staramr_excel = channel.empty()
    def ch_staramr_summary = channel.empty()
    def ch_staramr_detailed_summary = channel.empty()
    def ch_staramr_tables = channel.empty()
    def run_staramr = params.steps.staramr.toString() == 'true' && (run_shovill)
    if (run_staramr) {
        STEP_staramr(((run_shovill) ? ch_shovill_contigs.map { it[1] }.collect().ifEmpty([]) : channel.value([])))
        ch_staramr_excel = STEP_staramr.out.excel.map { f -> tuple([id: 'all'], f) }
        ch_staramr_summary = STEP_staramr.out.summary.map { f -> tuple([id: 'all'], f) }
        ch_staramr_detailed_summary = STEP_staramr.out.detailed_summary.map { f -> tuple([id: 'all'], f) }
        ch_staramr_tables = STEP_staramr.out.tables.map { f -> tuple([id: 'all'], f) }
        versions = versions.mix(STEP_staramr.out.versions)
    }

    // ---- emmtyper
    def ch_emmtyper_report = channel.empty()
    def run_emmtyper = params.steps.emmtyper.toString() == 'true' && (run_shovill)
    if (run_emmtyper) {
        STEP_emmtyper(ch_shovill_contigs)
        ch_emmtyper_report = STEP_emmtyper.out.report
        versions = versions.mix(STEP_emmtyper.out.versions)
    }

    // ---- abricate_bac
    def ch_abricate_bac_report = channel.empty()
    def run_abricate_bac = params.steps.abricate_bac.toString() == 'true' && (run_shovill)
    if (run_abricate_bac) {
        STEP_abricate_bac(ch_shovill_contigs)
        ch_abricate_bac_report = STEP_abricate_bac.out.report
        versions = versions.mix(STEP_abricate_bac.out.versions)
    }

    // ---- abricate_cdip
    def ch_abricate_cdip_report = channel.empty()
    def run_abricate_cdip = params.steps.abricate_cdip.toString() == 'true' && (run_shovill)
    if (run_abricate_cdip) {
        STEP_abricate_cdip(ch_shovill_contigs)
        ch_abricate_cdip_report = STEP_abricate_cdip.out.report
        versions = versions.mix(STEP_abricate_cdip.out.versions)
    }

    // ---- compress
    def ch_compress_gz = channel.empty()
    def run_compress = params.steps.compress.toString() == 'true' && (run_shovill)
    if (run_compress) {
        STEP_compress(ch_shovill_contigs)
        ch_compress_gz = STEP_compress.out.gz
        versions = versions.mix(STEP_compress.out.versions)
    }

    // ---- checkm
    def ch_checkm_results = channel.empty()
    def run_checkm = params.steps.checkm.toString() == 'true' && (run_shovill)
    if (run_checkm) {
        STEP_checkm(((run_shovill) ? ch_shovill_contigs.map { it[1] }.collect().ifEmpty([]) : channel.value([])), file(params.databases.checkm_data, checkIfExists: true))
        ch_checkm_results = STEP_checkm.out.results.map { f -> tuple([id: 'all'], f) }
        versions = versions.mix(STEP_checkm.out.versions)
    }

    // ---- quast
    def ch_quast_report = channel.empty()
    def ch_quast_transposed = channel.empty()
    def ch_quast_html = channel.empty()
    def run_quast = params.steps.quast.toString() == 'true' && (run_shovill)
    if (run_quast) {
        STEP_quast(((run_shovill) ? ch_shovill_contigs.map { it[1] }.collect().ifEmpty([]) : channel.value([])))
        ch_quast_report = STEP_quast.out.report.map { f -> tuple([id: 'all'], f) }
        ch_quast_transposed = STEP_quast.out.transposed.map { f -> tuple([id: 'all'], f) }
        ch_quast_html = STEP_quast.out.html.map { f -> tuple([id: 'all'], f) }
        versions = versions.mix(STEP_quast.out.versions)
    }

    // ---- abritamr
    def ch_abritamr_matches = channel.empty()
    def ch_abritamr_partials = channel.empty()
    def ch_abritamr_virulence = channel.empty()
    def ch_abritamr_amrfinder = channel.empty()
    def run_abritamr = params.steps.abritamr.toString() == 'true' && (run_shovill)
    if (run_abritamr) {
        STEP_abritamr(ch_shovill_contigs)
        ch_abritamr_matches = STEP_abritamr.out.matches
        ch_abritamr_partials = STEP_abritamr.out.partials
        ch_abritamr_virulence = STEP_abritamr.out.virulence
        ch_abritamr_amrfinder = STEP_abritamr.out.amrfinder
        versions = versions.mix(STEP_abritamr.out.versions)
    }

    // ---- summary
    def ch_summary_tables = channel.empty()
    def run_summary = params.steps.summary.toString() == 'true'
    if (run_summary) {
        STEP_summary(((run_mlst) ? ch_mlst_report.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_sistr) ? ch_sistr_prediction.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_abricate_bac) ? ch_abricate_bac_report.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_abricate_cdip) ? ch_abricate_cdip_report.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_quast) ? ch_quast_report.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_emmtyper) ? ch_emmtyper_report.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_checkm) ? ch_checkm_results.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_shovill) ? ch_shovill_log.map { it[1] }.collect().ifEmpty([]) : channel.value([])), ((run_bracken) ? ch_bracken_abundance.map { it[1] }.collect().ifEmpty([]) : channel.value([])), file("${projectDir}/tools/summary/summarise.py", checkIfExists: true))
        ch_summary_tables = STEP_summary.out.tables.map { f -> tuple([id: 'all'], f) }
        versions = versions.mix(STEP_summary.out.versions)
    }

    versions
        .map { it.text.trim() }
        .unique()
        .collectFile(name: 'tool_versions.yml', storeDir: "${params.outdir}/pipeline_info", sort: true, newLine: true)

    onComplete:
    Provenance.write(workflow, params, projectDir)
    log.info "Provenance: ${params.outdir}/pipeline_info/provenance.json"
}
