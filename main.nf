    [ -n "\$S_identity" ] && args+=(--identity "\$S_identity")
    abritamr run -c "\$IN_contigs" -px "\$SAMPLE" -j "\$CPUS" "\${args[@]}"
    for f in summary_matches summary_partials summary_virulence; do
        cp "\$SAMPLE/\$f.txt" "out/\$SAMPLE.abritamr.\$f.txt"
    done
    cp "\$SAMPLE/amrfinder.out" "out/\$SAMPLE.amrfinder.out"

    printf '%s: %s\\n' 'abritamr' "\$( (abritamr --version 2>&1 | sed 's/^abritamr //') 2>&1 | head -1 )" >> versions.yml
    printf '%s: %s\\n' 'amrfinderplus' "\$( (amrfinder --version 2>&1 | tail -1) 2>&1 | head -1 )" >> versions.yml
    printf '%s: %s\\n' 'amrfinderplus_db' "\$( (python -c "import abritamr,os;p=os.path.join(os.path.dirname(abritamr.__file__),'db','amrfinderplus','data');print(sorted(d for d in os.listdir(p) if d[0].isdigit())[-1])") 2>&1 | head -1 )" >> versions.yml
    echo 'container.STEP_abritamr: quay.io/biocontainers/abritamr:1.3.0--pyh5707d69_0' >> versions.yml
    [ -f .ntg_notes ] && sed 's/^/note.abritamr./' .ntg_notes >> versions.yml || true
    """
}
