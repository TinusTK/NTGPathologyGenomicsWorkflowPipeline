// GENERATED by `ntg compile`: step switches, settings and databases for this workflow.
params {
    workflow_id      = 'rdh_v5_2'
    workflow_version = 1
    workflow_name    = 'Genomic Assembly and analysis - RDH version 5.2'
    reads_pattern    = '*_R{1,2}*.gz'

    steps {
        fastp = true
        shovill = true
        kraken2 = true
        bracken = true
        sistr = true
        mlst = true
        staramr = true
        emmtyper = true
        abricate_bac = true
        abricate_cdip = true
        compress = true
        checkm = true
        quast = true
        abritamr = true
        summary = true
    }

    settings {
        shovill {
            assembler = 'spades'
            depth = 150
            ram = 0
            low_memory = false
            gsize = ''
            minlen = 0
            mincov = 2
            namefmt = 'contig%05d'
            trim = false
            nocorr = true
            kmers = ''
            opts = ''
        }
        kraken2 {
            confidence = 0.0
            min_base_quality = 0
            minimum_hit_groups = 2
            quick = false
        }
        bracken {
            level = 'S'
            threshold = 10
            read_len = 150
        }
        sistr {
            qc = true
            run_mash = true
            no_cgmlst = false
            use_full_cgmlst_db = false
        }
        mlst {
            scheme = ''
        }
        staramr {
            pid_threshold = 98.0
            plength_resfinder = 60.0
            plength_pointfinder = 95.0
            plength_plasmidfinder = 60.0
            pointfinder_organism = ''
            mlst_scheme = 'auto'
            genome_size_lower_bound = 4000000
            genome_size_upper_bound = 6000000
            minimum_n50_value = 10000
            minimum_contig_length = 300
            unacceptable_number_contigs = 1000
            report_all_blast = false
            exclude_negatives = false
        }
        emmtyper {
            workflow = 'blast'
            cluster_distance = 500
        }
        abricate_bac {
            db = 'ncbi'
            minid = 80.0
            mincov = 80.0
            noheader = false
        }
        abricate_cdip {
            db = 'vfdb'
            minid = 80.0
            mincov = 80.0
            noheader = true
        }
        checkm {
            tree = 'auto'
            unique = 10
            multi = 10
        }
        quast {
            min_contig = 500
            contig_thresholds = '0,1000'
        }
        abritamr {
            species = ''
            identity = ''
        }
    }

    databases {
        checkm_data = "${params.db_dir}/checkm/checkm_data_2015_01_16"
        kraken2_standard_8 = "${params.db_dir}/kraken2/k2_standard_08_GB_20260626"
    }
}
