#!/usr/bin/env bash
# NTG pathology genomics workflow - command line and UI launcher.
#   ./ntg ui                      open the browser UI
#   ./ntg run rdh_v5_2 fastq/     run a workflow on a folder of reads
#   ./ntg db install <id>         download a reference database
#   ./ntg tools install <pack>    install a tool pack from git
#   ./ntg hardware                this computer's specs and warnings
#   ./ntg --help                  everything else
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m app.cli "$@"
